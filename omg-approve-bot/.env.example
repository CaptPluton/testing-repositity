# Токен бота от @BotFather (можно оставить тот же @omg_approve_bot: старый код удаляется, токен остаётся)
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Только этот аккаунт управляет ботом.
OWNER_TG_ID=
# ID или @username канала OMG, куда бот публикует. Бот должен быть администратором канала с правом публикации.
TG_CHANNEL_ID=@obgolts_media_group
# ID Google-таблицы «OMG · Маркетинг · Показатели» (из ссылки .../spreadsheets/d/<ID>/edit)
SHEET_ID=1wy6GP-TmYlIdugtytJlrcO2NCZJecvIxYkTKXC9qqs0
# Название листа согласования
SHEET_TAB=Согласование
# JSON сервисного аккаунта Google одной строкой (или путь к файлу в GOOGLE_SERVICE_ACCOUNT_FILE).
# Сервисному аккаунту нужно дать доступ «Редактор» к таблице и «Читатель» к папке OMG на Диске.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Часовой пояс времени публикации в таблице (колонка «Время (Пхукет)»)
TZ=Asia/Bangkok
# Как часто бот перечитывает таблицу, секунд
POLL_INTERVAL_SEC=120
# Час утреннего дайджеста ожидающих карточек (по TZ)
DIGEST_HOUR=9
# За сколько минут до времени YouTube-ролика прислать пакет и напоминание
YT_REMINDER_MIN_BEFORE=30
# Путь к базе состояния (на Railway подключите Volume в /data)
DB_PATH=/data/bot.db
