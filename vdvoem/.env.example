# Telegram bot token from @BotFather (never commit the real one)
BOT_TOKEN=
# Public https URL of this deployment (Railway domain), no trailing slash
PUBLIC_URL=https://your-app.up.railway.app
# Short name of the Mini App created in @BotFather via /newapp (default: app)
MINI_APP_SHORT_NAME=app

# Google OAuth (Yana's Google Cloud project), redirect URI = $PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Optional: natural-language assistant in the chat (rule-based parser works without it)
ANTHROPIC_API_KEY=

# Storage: mount a Railway volume here so data survives redeploys
DATA_DIR=/data
PORT=3000

# Local development only
# DEV_USER=yana
# DISABLE_BOT=1
